# 환경변수로 적용하세요. .env 파일은 자동 로드하지 않습니다.
TRADE_DB_PATH=data/trade.sqlite3
TRADE_INITIAL_CASH=1000000
TRADE_ORDER_KRW=100000
TRADE_MAX_EXPOSURE=0.30
TRADE_DAILY_LOSS_LIMIT=0.03
# 아래 값은 모의 체결 가정이며 실제 업비트 수수료를 조회한 값이 아닙니다.
TRADE_FEE_RATE=0.0005
TRADE_SLIPPAGE=0.001
TRADE_SHORT_WINDOW=5
TRADE_LONG_WINDOW=20
TRADE_CANDLE_MINUTES=5
TRADE_POLL_SECONDS=30
TRADE_MAX_QUOTE_AGE_SECONDS=60
TRADE_STRATEGY=ma_cross
TRADE_DCA_INTERVAL_HOURS=24
TRADE_TARGET_EXPOSURE=0.20
TRADE_REBALANCE_TOLERANCE=0.02

# 텔레그램 봇 토큰·채팅 ID와 업비트 실거래 키는 웹 UI에서 설정합니다.

# 연속 전략은 웹 UI에서 선택하거나 STRATEGY=consecutive와 CANDLE_MINUTES=1을 함께 설정합니다.
TRADE_CONSECUTIVE_ENTRY_RETURN=0.005
TRADE_CONSECUTIVE_TAKE_PROFIT=0.03
TRADE_CONSECUTIVE_STOP_LOSS=0.10
TRADE_CONSECUTIVE_COUNT=3

# 연속 전략 봉 단위: 10 / 30 / 60초. 기존 설정은 60초 유지.
TRADE_CONSECUTIVE_SECONDS=60
